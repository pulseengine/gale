// MPU: the STM32F100 HAS NONE. Measured over SWD on the real part (halted):
//   MPU_TYPE (0xE000ED90) = 0x00000000  -> DREGION 0
// The MPU is OPTIONAL on Cortex-M3 and this part omits it.
//
// THIS LINE IS LOad-BEARING. Renode DEFAULTS a Cortex-M to EIGHT MPU regions when the
// platform says nothing, so silence here does not mean "no MPU" -- it means "8 regions".
// Verified on this very file before the fix: MPU_TYPE read 0x00000800.
// Absence in a platform description is not absence in the model.
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m3"
    numberOfMPURegions: 0
    nvic: nvic
nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x20000
sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x2000
rcc: Memory.MappedMemory @ sysbus 0x40021000
    size: 0x400
gpioa: Memory.MappedMemory @ sysbus 0x40010800
    size: 0x400
usart1: UART.STM32_UART @ sysbus <0x40013800, +0x100>
    -> nvic@37
