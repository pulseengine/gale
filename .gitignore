# Rust build artifacts
target/
ffi/target/

# StrictDoc cache
upstream-reqif/_cache/

# Bazel
bazel-*
*.rlib
# Host-resolved module lock from local bazel runs (CI resolves its own; the
# renode-test module is intentionally lock-free so Linux CI isn't pinned to a
# macOS-generated graph).
MODULE.bazel.lock

# Agent working state (per-package; not source — see issue-hunt skill)
.claude/pulseengine/
**/.claude/pulseengine/
# Session-local scheduler state: a lock carrying a PID + sessionId, rewritten on
# every scheduled-task tick. It was tracked from #48 (swept into an unrelated
# rivet fix) and dirties the tree for anyone running a scheduled task, which is
# exactly how it gets swept in again.
.claude/scheduled_tasks.lock
**/.claude/scheduled_tasks.lock
benches/gust/drivers/gustos-components/

# Robot/Renode run artifacts — regenerated by every `robot` invocation in
# benches/gust; the evidence we keep is committed under measurements/, not these.
benches/gust/log.html
benches/gust/report.html
benches/gust/robot_output.xml
benches/gust/logs/
benches/gust/snapshots/

# jco-generated browser bindings + the wasm copied in beside them. Rules are
# scoped to the generated paths so hand-written sources here stay tracked.
benches/gust/browser-nano/web/gen/
benches/gust/browser-nano/web/*.wasm

# Playwright MCP scratch (page snapshots, console logs) — session state, not source.
.playwright-mcp/

# Python bytecode
__pycache__/
*.pyc
