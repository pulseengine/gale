  -- END targets/reference import
  -- Board-level pins: the user LEDs, buttons and the console UART (the one the board
  -- routes to its debug probe's serial port), from the board devicetree of the pinned
  -- Zephyr fork; cross-checked against targets/reference/stm32wb55.board.tsv.
  device Led_Led1  -- PB5
    properties
      Gust_Target_Props::Board_Led => true;
      Gust_Target_Props::Gpio_Port  => 1;
      Gust_Target_Props::Gpio_Pin   => 5;
      Gust_Target_Props::Active_Low => false;
  end Led_Led1;
  device Led_Led2  -- PB0
    properties
      Gust_Target_Props::Board_Led => true;
      Gust_Target_Props::Gpio_Port  => 1;
      Gust_Target_Props::Gpio_Pin   => 0;
      Gust_Target_Props::Active_Low => false;
  end Led_Led2;
  device Led_Led3  -- PB1
    properties
      Gust_Target_Props::Board_Led => true;
      Gust_Target_Props::Gpio_Port  => 1;
      Gust_Target_Props::Gpio_Pin   => 1;
      Gust_Target_Props::Active_Low => false;
  end Led_Led3;
  device Button_Sw1  -- PC4
    properties
      Gust_Target_Props::Board_Button => true;
      Gust_Target_Props::Gpio_Port  => 2;
      Gust_Target_Props::Gpio_Pin   => 4;
      Gust_Target_Props::Active_Low => true;
  end Button_Sw1;
  device Button_Sw2  -- PD0
    properties
      Gust_Target_Props::Board_Button => true;
      Gust_Target_Props::Gpio_Port  => 3;
      Gust_Target_Props::Gpio_Pin   => 0;
      Gust_Target_Props::Active_Low => true;
  end Button_Sw2;
  device Button_Sw3  -- PD1
    properties
      Gust_Target_Props::Board_Button => true;
      Gust_Target_Props::Gpio_Port  => 3;
      Gust_Target_Props::Gpio_Pin   => 1;
      Gust_Target_Props::Active_Low => true;
  end Button_Sw3;
  device Board_Console  -- USART1
    properties
      Gust_Target_Props::Base    => 16#40013800#;
      Gust_Target_Props::Console => true;
      Gust_Target_Props::Tx_Port => 1;
      Gust_Target_Props::Tx_Pin  => 6;
      Gust_Target_Props::Rx_Port => 1;
      Gust_Target_Props::Rx_Pin  => 7;
  end Board_Console;
  system Board
    annex EMV2 {**
      error types
        TaskHang    : type;
        SystemReset : type;
      end types;
      error behavior WatchdogBehavior
        events   Hang : error event;
        states   Nominal : initial state; Reset : state;
        transitions Nominal -[ Hang ]-> Reset;   -- unrefreshed hang -> IWDG resets to safe state
      end behavior;
    **};
  end Board;
  system implementation Board.nucleo
    subcomponents
      cpu   : processor Cortex_M::CortexM4;
      flash : memory Flag_Flash.i;
      sram  : memory Ram.i;
      mpu   : device Mpu;
      iwdg  : device Iwdg;
      rcc   : device Rcc;
      led_led1 : device Led_Led1;
      led_led2 : device Led_Led2;
      led_led3 : device Led_Led3;
      button_sw1 : device Button_Sw1;
      button_sw2 : device Button_Sw2;
      button_sw3 : device Button_Sw3;
      board_console : device Board_Console;
      -- BEGIN targets/reference import
      periph_adc1 : device Adc1;
      periph_adc1_common : device Adc1_Common;
      periph_aes1 : device Aes1;
      periph_aes2 : device Aes2;
      periph_comp1 : device Comp1;
      periph_comp2 : device Comp2;
      periph_crc : device Crc;
      periph_crs : device Crs;
      periph_dbgmcu : device Dbgmcu;
      periph_dma1 : device Dma1;
      periph_dma2 : device Dma2;
      periph_dmamux1 : device Dmamux1;
      periph_exti : device Exti;
