package STM32F100
public
  with Cortex_M; with Gust_Target_Props;

  memory Flag_Flash end Flag_Flash;
  memory implementation Flag_Flash.i
    properties Gust_Target_Props::Base => 16#08000000#; Gust_Target_Props::Length => 131072;
  end Flag_Flash.i;

  memory Ram end Ram;
  memory implementation Ram.i
    properties Gust_Target_Props::Base => 16#20000000#; Gust_Target_Props::Length => 8192;
  end Ram.i;

  -- MEASURED 2026-09-04 over the VLDISCOVERY's ST-LINK/V1: MPU_TYPE (0xE000ED90)
  -- reads 0x00000000, so DREGION = 0 and this part has NO MPU (it is optional on
  -- Cortex-M3). Declared rather than omitted so a consumer asking "can this target
  -- isolate?" gets an answer instead of a missing key.
  device Mpu
    properties
      -- The MPU register block is ARCHITECTURAL (ARMv7-M PPB), identical on every
      -- Cortex-M, so this Base is not board-specific. MPU_TYPE lives at Base+0.
      Gust_Target_Props::Base    => 16#E000ED90#;
      Gust_Target_Props::Present => false;
      Gust_Target_Props::Dregion => 0;
  end Mpu;

  device Iwdg
    properties Gust_Target_Props::Base => 16#40003000#; Gust_Target_Props::Present => true;
  end Iwdg;

  -- Apb2enr_Offset (RCC_APB2ENR = 16#40021018#) is SILICON-proven on this part:
  -- gust_adc_silicon.rs sets ADC1EN through it before every Vrefint read, and the
  -- real STM32VLDISCOVERY returned 1645/1646 raw (silicon/RESULTS-f100.md) — an
  -- unclocked ADC cannot convert, so a wrong offset could not have produced it.
  device Rcc
    properties
      Gust_Target_Props::Base           => 16#40021000#;
      Gust_Target_Props::Csr_Offset     => 16#24#;
      Gust_Target_Props::Apb2enr_Offset => 16#18#;
      Gust_Target_Props::Iwdgrstf_Bit   => 29;
      Gust_Target_Props::Rmvf_Bit       => 24;
  end Rcc;

  device Adc
    properties
      Gust_Target_Props::Base       => 16#40012400#;
      Gust_Target_Props::Vrefint_Ch => 17;
      Gust_Target_Props::Present    => true;
  end Adc;

  -- USART1 — the uart-thin driver's peripheral and every driver gate's report
  -- channel. The only peripheral here checked against a REAL Renode register
  -- model (UART.STM32_UART @ <0x40013800,+0x100> in renode-test/m3_64k.repl and
  -- stm32f100.repl), content-gated by //:gust-uart-renode; the F100-linked image
  -- also flashed + ran to completion on the physical VLDISCOVERY
  -- (drivers/uart-thin/SILICON.md). Offsets per drivers/uart-thin/src/lib.rs.
  device Usart1
    properties
      Gust_Target_Props::Base       => 16#40013800#;
      Gust_Target_Props::Sr_Offset  => 16#00#;
      Gust_Target_Props::Dr_Offset  => 16#04#;
      Gust_Target_Props::Brr_Offset => 16#08#;
      Gust_Target_Props::Cr1_Offset => 16#0C#;
      Gust_Target_Props::Present    => true;
  end Usart1;

  -- GPIOA — the board bring-up port: PA9 is USART1 TX, configured through
  -- GPIOA + Crh_Offset (16#40010804#) by every gate demonstrator and by the
  -- F100 image that ran on real silicon. Modelled in renode-test/f100_silicon.repl
  -- as gpioa @ 0x40010800.
  device Gpioa
    properties
      Gust_Target_Props::Base       => 16#40010800#;
      Gust_Target_Props::Crh_Offset => 16#04#;
      Gust_Target_Props::Present    => true;
  end Gpioa;

  -- GPIOC — the port the dissolved gpio-thin driver drives (PC8). Exercised by
  -- //:gust-gpio-renode and //:gust-breadth-renode against a register window at
  -- this base; offsets per drivers/gpio-thin/src/lib.rs. NOTE: those gates map
  -- the window as plain memory, so they pin the base the firmware uses but do
  -- not independently confirm it against silicon (unlike Usart1/Rcc/Adc).
  device Gpioc
    properties
      Gust_Target_Props::Base        => 16#40011000#;
      Gust_Target_Props::Crh_Offset  => 16#04#;
      Gust_Target_Props::Bsrr_Offset => 16#10#;
      Gust_Target_Props::Present     => true;
  end Gpioc;

  -- TIM2 — the dissolved timer-thin driver's timer, and the counter the
  -- os time-provider reads (TIM2 + Cnt_Offset = 16#40000024#). Exercised by
  -- //:gust-timer-renode and //:gust-breadth-renode; same plain-memory-window
  -- caveat as Gpioc.
  device Tim2
    properties
      Gust_Target_Props::Base       => 16#40000000#;
      Gust_Target_Props::Cnt_Offset => 16#24#;
      Gust_Target_Props::Present    => true;
  end Tim2;

  -- SPI1 — the dissolved spi-thin driver's peripheral. Exercised by
  -- //:gust-spi-renode and //:gust-breadth-renode; offsets per
  -- drivers/spi-thin/src/lib.rs. Same plain-memory-window caveat as Gpioc.
  device Spi1
    properties
      Gust_Target_Props::Base       => 16#40013000#;
      Gust_Target_Props::Cr1_Offset => 16#00#;
      Gust_Target_Props::Sr_Offset  => 16#08#;
      Gust_Target_Props::Dr_Offset  => 16#0C#;
      Gust_Target_Props::Present    => true;
  end Spi1;

  -- BEGIN targets/reference import: generated by targets/reference/import_aadl.py, do not edit
  device Adc1_Common
    properties
      Gust_Target_Props::Base         => 16#40012400#;
      Gust_Target_Props::Address_Only => true;
  end Adc1_Common;
  device Afio
    properties
      Gust_Target_Props::Base         => 16#40010000#;
      Gust_Target_Props::Address_Only => true;
  end Afio;
  device Bkp
    properties
      Gust_Target_Props::Base         => 16#40006C00#;
      Gust_Target_Props::Address_Only => true;
  end Bkp;
  device Cec
    properties
      Gust_Target_Props::Base         => 16#40007800#;
      Gust_Target_Props::Address_Only => true;
  end Cec;
  device Crc
    properties
      Gust_Target_Props::Base         => 16#40023000#;
      Gust_Target_Props::Address_Only => true;
  end Crc;
  device Dac1
    properties
      Gust_Target_Props::Base         => 16#40007400#;
      Gust_Target_Props::Address_Only => true;
  end Dac1;
  device Dbgmcu
    properties
      Gust_Target_Props::Base         => 16#E0042000#;
      Gust_Target_Props::Address_Only => true;
  end Dbgmcu;
  device Dma1
    properties
      Gust_Target_Props::Base         => 16#40020000#;
      Gust_Target_Props::Address_Only => true;
  end Dma1;
  device Exti
    properties
      Gust_Target_Props::Base         => 16#40010400#;
      Gust_Target_Props::Address_Only => true;
  end Exti;
  device Flash
    properties
      Gust_Target_Props::Base         => 16#40022000#;
      Gust_Target_Props::Address_Only => true;
  end Flash;
  device Gpiob
    properties
      Gust_Target_Props::Base         => 16#40010C00#;
      Gust_Target_Props::Address_Only => true;
  end Gpiob;
  device Gpiod
    properties
      Gust_Target_Props::Base         => 16#40011400#;
      Gust_Target_Props::Address_Only => true;
  end Gpiod;
  device Gpioe
    properties
      Gust_Target_Props::Base         => 16#40011800#;
      Gust_Target_Props::Address_Only => true;
  end Gpioe;
  device I2c1
    properties
      Gust_Target_Props::Base         => 16#40005400#;
      Gust_Target_Props::Address_Only => true;
  end I2c1;
  device I2c2
    properties
      Gust_Target_Props::Base         => 16#40005800#;
      Gust_Target_Props::Address_Only => true;
  end I2c2;
  device Pwr
    properties
      Gust_Target_Props::Base         => 16#40007000#;
      Gust_Target_Props::Address_Only => true;
  end Pwr;
  device Rtc
    properties
      Gust_Target_Props::Base         => 16#40002800#;
      Gust_Target_Props::Address_Only => true;
  end Rtc;
  device Spi2
    properties
      Gust_Target_Props::Base         => 16#40003800#;
      Gust_Target_Props::Address_Only => true;
  end Spi2;
  device Tim1
    properties
      Gust_Target_Props::Base         => 16#40012C00#;
      Gust_Target_Props::Address_Only => true;
  end Tim1;
  device Tim15
    properties
      Gust_Target_Props::Base         => 16#40014000#;
      Gust_Target_Props::Address_Only => true;
  end Tim15;
  device Tim16
    properties
      Gust_Target_Props::Base         => 16#40014400#;
      Gust_Target_Props::Address_Only => true;
  end Tim16;
  device Tim17
    properties
      Gust_Target_Props::Base         => 16#40014800#;
      Gust_Target_Props::Address_Only => true;
  end Tim17;
  device Tim3
    properties
      Gust_Target_Props::Base         => 16#40000400#;
      Gust_Target_Props::Address_Only => true;
  end Tim3;
  device Tim4
    properties
      Gust_Target_Props::Base         => 16#40000800#;
      Gust_Target_Props::Address_Only => true;
  end Tim4;
  device Tim6
    properties
      Gust_Target_Props::Base         => 16#40001000#;
      Gust_Target_Props::Address_Only => true;
  end Tim6;
  device Tim7
    properties
      Gust_Target_Props::Base         => 16#40001400#;
      Gust_Target_Props::Address_Only => true;
  end Tim7;
  device Uid
    properties
      Gust_Target_Props::Base         => 16#1FFFF7E8#;
      Gust_Target_Props::Address_Only => true;
  end Uid;
  device Usart2
    properties
      Gust_Target_Props::Base         => 16#40004400#;
      Gust_Target_Props::Address_Only => true;
  end Usart2;
  device Usart3
    properties
      Gust_Target_Props::Base         => 16#40004800#;
      Gust_Target_Props::Address_Only => true;
  end Usart3;
  device Wwdg
    properties
      Gust_Target_Props::Base         => 16#40002C00#;
      Gust_Target_Props::Address_Only => true;
  end Wwdg;
  -- END targets/reference import
  -- Board-level pins: the user LEDs, buttons and the console UART (the one the board
  -- routes to its debug probe's serial port), from the board devicetree of the pinned
  -- Zephyr fork; cross-checked against targets/reference/stm32f100.board.tsv.
  device Led_Ld3  -- PC9
    properties
      Gust_Target_Props::Board_Led => true;
      Gust_Target_Props::Gpio_Port  => 2;
      Gust_Target_Props::Gpio_Pin   => 9;
      Gust_Target_Props::Active_Low => false;
  end Led_Ld3;
  device Led_Ld4  -- PC8
    properties
      Gust_Target_Props::Board_Led => true;
      Gust_Target_Props::Gpio_Port  => 2;
      Gust_Target_Props::Gpio_Pin   => 8;
      Gust_Target_Props::Active_Low => false;
  end Led_Ld4;
  device Button_User  -- PA0
    properties
      Gust_Target_Props::Board_Button => true;
      Gust_Target_Props::Gpio_Port  => 0;
      Gust_Target_Props::Gpio_Pin   => 0;
      Gust_Target_Props::Active_Low => true;
  end Button_User;
  device Board_Console  -- USART1
    properties
      Gust_Target_Props::Base    => 16#40013800#;
      Gust_Target_Props::Console => true;
      Gust_Target_Props::Tx_Port => 0;
      Gust_Target_Props::Tx_Pin  => 9;
      Gust_Target_Props::Rx_Port => 0;
      Gust_Target_Props::Rx_Pin  => 10;
  end Board_Console;
  system Board
    annex EMV2 {**
      error types
        TaskHang    : type;
        SystemReset : type;
      end types;
      error behavior WatchdogBehavior
        events   Hang : error event;
        states   Nominal : initial state; Reset : state;
        transitions Nominal -[ Hang ]-> Reset;   -- unrefreshed hang -> IWDG resets to safe state
      end behavior;
    **};
  end Board;
  system implementation Board.vldiscovery
    subcomponents
      cpu    : processor Cortex_M::CortexM3;
      flash  : memory Flag_Flash.i;
      sram   : memory Ram.i;
      mpu    : device Mpu;
      iwdg   : device Iwdg;
      rcc    : device Rcc;
      adc    : device Adc;
      usart1 : device Usart1;
      gpioa  : device Gpioa;
      gpioc  : device Gpioc;
      tim2   : device Tim2;
      spi1   : device Spi1;
      led_ld3 : device Led_Ld3;
      led_ld4 : device Led_Ld4;
      button_user : device Button_User;
      board_console : device Board_Console;
      -- BEGIN targets/reference import
      periph_adc1_common : device Adc1_Common;
      periph_afio : device Afio;
      periph_bkp : device Bkp;
      periph_cec : device Cec;
      periph_crc : device Crc;
      periph_dac1 : device Dac1;
      periph_dbgmcu : device Dbgmcu;
      periph_dma1 : device Dma1;
      periph_exti : device Exti;
      periph_flash : device Flash;
      periph_gpiob : device Gpiob;
      periph_gpiod : device Gpiod;
      periph_gpioe : device Gpioe;
      periph_i2c1 : device I2c1;
      periph_i2c2 : device I2c2;
      periph_pwr : device Pwr;
      periph_rtc : device Rtc;
      periph_spi2 : device Spi2;
      periph_tim1 : device Tim1;
      periph_tim15 : device Tim15;
      periph_tim16 : device Tim16;
      periph_tim17 : device Tim17;
      periph_tim3 : device Tim3;
      periph_tim4 : device Tim4;
      periph_tim6 : device Tim6;
      periph_tim7 : device Tim7;
      periph_uid : device Uid;
      periph_usart2 : device Usart2;
      periph_usart3 : device Usart3;
      periph_wwdg : device Wwdg;
      -- END targets/reference import
  end Board.vldiscovery;
end STM32F100;
