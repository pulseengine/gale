package STM32G031
public
  with Cortex_M; with Gust_Target_Props;

  -- NUCLEO-G031K8 — STM32G031K8, Cortex-M0+ r0p1 (CPUID 0x410cc601, DBGMCU 0x10036466).
  -- Every value below was MEASURED over the board's own debug probe on the shared
  -- bench host (2026-09-16, gale#397) unless it says otherwise.
  -- ARMv6-M. No FPU (MVFR0 0x00000000). No dissolved driver can run here yet: synth
  -- has no ARMv6-M profile (synth#1301). Native Rust (thumbv6m-none-eabi) runs.
  memory Flag_Flash end Flag_Flash;
  memory implementation Flag_Flash.i
    -- flash-size register 0x1FFF75E0 reads 64 (KB).
    properties Gust_Target_Props::Base => 16#08000000#; Gust_Target_Props::Length => 65536;
  end Flag_Flash.i;

  memory Ram end Ram;
  memory implementation Ram.i
    -- 8 KB: 0x20001FFC reads, 0x20002000 faults — bounded on silicon.
    properties Gust_Target_Props::Base => 16#20000000#; Gust_Target_Props::Length => 8192;
  end Ram.i;

  -- MPU_TYPE (0xE000ED90) reads 0x00000800: DREGION = 8, the count the verified
  -- region programmer requires.
  device Mpu
    properties
      Gust_Target_Props::Base    => 16#E000ED90#;
      Gust_Target_Props::Present => true;
      Gust_Target_Props::Dregion => 8;
  end Mpu;

  -- IWDG at 16#40003000#: writing KR=0xCCCC here over the debugger, then letting the
  -- core run, reset the chip and set RCC_CSR.IWDGRSTF (see Rcc).
  device Iwdg
    properties Gust_Target_Props::Base => 16#40003000#; Gust_Target_Props::Present => true;
  end Iwdg;

  -- RCC_CSR = Base + Csr_Offset. Before: 0x1C000000. RMVF (bit 23) cleared it to 0x00000000; an IWDG
  -- reset then read 0x24000000 (IWDGRSTF, bit 29).

  device Rcc
    properties
      Gust_Target_Props::Base         => 16#40021000#;
      Gust_Target_Props::Csr_Offset   => 16#60#;
      Gust_Target_Props::Iwdgrstf_Bit => 29;
      Gust_Target_Props::Rmvf_Bit     => 23;
  end Rcc;

  -- DELIBERATELY EMPTY of peripherals beyond Mpu/Iwdg/Rcc, for the same reason as
  -- stm32g474.aadl: nothing else on this part has been measured, and a guessed base
  -- silently writes to the wrong peripheral.

  -- BEGIN targets/reference import: generated by targets/reference/import_aadl.py, do not edit
  device Adc1
    properties
      Gust_Target_Props::Base         => 16#40012400#;
      Gust_Target_Props::Address_Only => true;
  end Adc1;
  device Adc1_Common
    properties
      Gust_Target_Props::Base         => 16#40012708#;
      Gust_Target_Props::Address_Only => true;
  end Adc1_Common;
  device Crc
    properties
      Gust_Target_Props::Base         => 16#40023000#;
      Gust_Target_Props::Address_Only => true;
  end Crc;
