      Gust_Target_Props::Base         => 16#50000800#;
      Gust_Target_Props::Address_Only => true;
  end Gpioc;
  device Gpiod
    properties
      Gust_Target_Props::Base         => 16#50000C00#;
      Gust_Target_Props::Address_Only => true;
  end Gpiod;
  device Gpiof
    properties
      Gust_Target_Props::Base         => 16#50001400#;
      Gust_Target_Props::Address_Only => true;
  end Gpiof;
  device I2c1
    properties
      Gust_Target_Props::Base         => 16#40005400#;
      Gust_Target_Props::Address_Only => true;
  end I2c1;
  device I2c2
    properties
      Gust_Target_Props::Base         => 16#40005800#;
      Gust_Target_Props::Address_Only => true;
  end I2c2;
  device Lptim1
    properties
      Gust_Target_Props::Base         => 16#40007C00#;
      Gust_Target_Props::Address_Only => true;
  end Lptim1;
  device Lptim2
    properties
      Gust_Target_Props::Base         => 16#40009400#;
      Gust_Target_Props::Address_Only => true;
  end Lptim2;
  device Lpuart1
    properties
      Gust_Target_Props::Base         => 16#40008000#;
      Gust_Target_Props::Address_Only => true;
  end Lpuart1;
  device Pwr
    properties
      Gust_Target_Props::Base         => 16#40007000#;
      Gust_Target_Props::Address_Only => true;
  end Pwr;
  device Rtc
    properties
      Gust_Target_Props::Base         => 16#40002800#;
      Gust_Target_Props::Address_Only => true;
  end Rtc;
  device Spi1
    properties
      Gust_Target_Props::Base         => 16#40013000#;
      Gust_Target_Props::Address_Only => true;
  end Spi1;
  device Spi2
    properties
      Gust_Target_Props::Base         => 16#40003800#;
      Gust_Target_Props::Address_Only => true;
  end Spi2;
  device Syscfg
    properties
      Gust_Target_Props::Base         => 16#40010000#;
      Gust_Target_Props::Address_Only => true;
  end Syscfg;
  device Tamp
    properties
      Gust_Target_Props::Base         => 16#4000B000#;
      Gust_Target_Props::Address_Only => true;
  end Tamp;
  device Tim1
    properties
      Gust_Target_Props::Base         => 16#40012C00#;
      Gust_Target_Props::Address_Only => true;
  end Tim1;
  device Tim14
    properties
      Gust_Target_Props::Base         => 16#40002000#;
      Gust_Target_Props::Address_Only => true;
  end Tim14;
  device Tim16
    properties
      Gust_Target_Props::Base         => 16#40014400#;
