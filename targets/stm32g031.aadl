  device Tim17
    properties
      Gust_Target_Props::Base         => 16#40014800#;
      Gust_Target_Props::Address_Only => true;
  end Tim17;
  device Tim2
    properties
      Gust_Target_Props::Base         => 16#40000000#;
      Gust_Target_Props::Address_Only => true;
  end Tim2;
  device Tim3
    properties
      Gust_Target_Props::Base         => 16#40000400#;
      Gust_Target_Props::Address_Only => true;
  end Tim3;
  device Ts_Cal1
    properties
      Gust_Target_Props::Base         => 16#1FFF75A8#;
      Gust_Target_Props::Address_Only => true;
  end Ts_Cal1;
  device Ts_Cal2
    properties
      Gust_Target_Props::Base         => 16#1FFF75CA#;
      Gust_Target_Props::Address_Only => true;
  end Ts_Cal2;
  device Uid
    properties
      Gust_Target_Props::Base         => 16#1FFF7590#;
      Gust_Target_Props::Address_Only => true;
  end Uid;
  device Usart1
    properties
      Gust_Target_Props::Base         => 16#40013800#;
      Gust_Target_Props::Address_Only => true;
  end Usart1;
  device Usart2
    properties
      Gust_Target_Props::Base         => 16#40004400#;
      Gust_Target_Props::Address_Only => true;
  end Usart2;
  device Vrefbuf
    properties
      Gust_Target_Props::Base         => 16#40010030#;
      Gust_Target_Props::Address_Only => true;
  end Vrefbuf;
  device Vrefintcal
    properties
      Gust_Target_Props::Base         => 16#1FFF75AA#;
      Gust_Target_Props::Address_Only => true;
  end Vrefintcal;
  device Wwdg
    properties
      Gust_Target_Props::Base         => 16#40002C00#;
      Gust_Target_Props::Address_Only => true;
  end Wwdg;
  -- END targets/reference import
  system Board
    annex EMV2 {**
      error types
        TaskHang    : type;
        SystemReset : type;
      end types;
      error behavior WatchdogBehavior
        events   Hang : error event;
        states   Nominal : initial state; Reset : state;
        transitions Nominal -[ Hang ]-> Reset;   -- unrefreshed hang -> IWDG resets to safe state
      end behavior;
    **};
  end Board;
  system implementation Board.nucleo
    subcomponents
      cpu   : processor Cortex_M::CortexM0Plus;
      flash : memory Flag_Flash.i;
      sram  : memory Ram.i;
      mpu   : device Mpu;
      iwdg  : device Iwdg;
      rcc   : device Rcc;
      -- BEGIN targets/reference import
      periph_adc1 : device Adc1;
      periph_adc1_common : device Adc1_Common;
      periph_crc : device Crc;
      periph_dbgmcu : device Dbgmcu;
      periph_dma1 : device Dma1;
      periph_dmamux1 : device Dmamux1;
      periph_exti : device Exti;
      periph_flash : device Flash;
      periph_gpioa : device Gpioa;
      periph_gpiob : device Gpiob;
      periph_gpioc : device Gpioc;
      periph_gpiod : device Gpiod;
      periph_gpiof : device Gpiof;
      periph_i2c1 : device I2c1;
      periph_i2c2 : device I2c2;
      periph_lptim1 : device Lptim1;
      periph_lptim2 : device Lptim2;
      periph_lpuart1 : device Lpuart1;
      periph_pwr : device Pwr;
      periph_rtc : device Rtc;
      periph_spi1 : device Spi1;
      periph_spi2 : device Spi2;
      periph_syscfg : device Syscfg;
      periph_tamp : device Tamp;
      periph_tim1 : device Tim1;
      periph_tim14 : device Tim14;
      periph_tim16 : device Tim16;
      periph_tim17 : device Tim17;
      periph_tim2 : device Tim2;
      periph_tim3 : device Tim3;
      periph_ts_cal1 : device Ts_Cal1;
      periph_ts_cal2 : device Ts_Cal2;
      periph_uid : device Uid;
      periph_usart1 : device Usart1;
      periph_usart2 : device Usart2;
      periph_vrefbuf : device Vrefbuf;
      periph_vrefintcal : device Vrefintcal;
      periph_wwdg : device Wwdg;
      -- END targets/reference import
