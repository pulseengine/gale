// gust:os — the OS syscall seam (v0.4.0, REQ-OS-SYSCALL-001). The single surface an
// app sees: it imports `gust:os` capabilities and is portable across nodes; the
// node's providers (kiln, gale::msgq, the dissolved drivers) EXPORT these, and the
// meld-fuse dissolves the seam away. Design:
// docs/superpowers/specs/2026-07-09-gust-os-syscall-seam-design.md
package gust:os@0.1.0;

/// Monotonic time — all-scalar, so this capability stays flat / 0-SRAM. Backed by a
/// hardware timer through the node's TCB (gust:hal/mmio, via timer-comp).
interface time {
    /// Monotonic tick counter (wraps per the underlying timer width; math below is
    /// wrap-safe over the 32-bit domain, widened to u64 at the seam).
    now: func() -> u64;
    /// Deadline = now + ticks (wrap-safe).
    deadline: func(now: u64, ticks: u64) -> u64;
    /// Has the deadline been reached? (wrap-safe: elapsed once now has passed it).
    elapsed: func(now: u64, deadline: u64) -> bool;
    /// ticks per second (timer Hz)
    resolution: func() -> u64;
}

/// Structured line/byte log — carries bytes, so this capability needs the node's
/// bounded shared linmem (not 0-SRAM). Backed by uart-comp or a semihosting bridge.
interface log {
    line: func(msg: list<u8>);
}

/// Trusted task-dispatch seam — the executor's `poll_task` FFI (plain/src/
/// executor.rs), WIT-typed so the spawn provider componentizes (`wasm-tools
/// component new` rejects the raw `env::poll_task` core import; see
/// drivers/spawn-provider/RESULTS.md "Deferred"). The node's TRUSTED layer
/// dispatches app task `id`'s pending poll once and returns 1 if it completed,
/// 0 if still pending — same contract as `poll_task`, which gust_exec_probe
/// already resolves natively. Dissolving leaves this as the ts-node's single
/// non-mmio undefined symbol, resolved by the probe/bridge at final link.
interface taskdisp {
    poll-task: func(id: u32) -> u32;
}

/// The executor's other half: direct admit/drive/inspect of the verified scheduler
/// (plain/src/executor.rs), under the app-facing `spawn`/`timer` capabilities. Both
/// 64-bit values cross as lo/hi u32 halves — synth's ARM backend silently drops an
/// exported function carrying an i64 param (drivers/exec-provider/RESULTS.md), and
/// keeping the WIT identical to the dissolved object's C-ABI means the qemu probe
/// and a composed node call the same shape.
interface exec {
    /// Admit a task at `prio` (lower = higher priority) with wake-by deadline
    /// `deadline-lo`/`deadline-hi` (tick units; u64 max = no timer). Returns the
    /// handle, or 0xFFFF_FFFF if the MAX_TASKS=8 table is full.
    admit: func(prio: u32, deadline-lo: u32, deadline-hi: u32) -> u32;
    /// Drive one round at time `now`: fire the tickless alarm, then drain every
    /// ready task exactly once through `taskdisp.poll-task`.
    poll-round: func(now-lo: u32, now-hi: u32);
    /// Task `h`'s state: 0 = free, 1 = pending, 2 = done, 0xFFFF_FFFF = invalid.
    state: func(h: u32) -> u32;
}

/// Cooperative task spawn — a scalar handle into the kiln executor; the app polls it
/// (no host Future crosses the seam). Backed by kiln.
interface spawn {
    /// Register a task (identified by an app-side entry id); returns a task handle.
    start: func(entry: u32) -> u32;
    /// Poll a task handle: 0 = pending, 1 = done, 0xFFFF_FFFF = invalid.
    poll: func(handle: u32) -> u32;
}

/// Tickless one-shot timers over the verified executor's deadline table. A
/// component registers a wake and polls it — no host Future, no busy-poll.
interface timer {
    /// Arm a one-shot wake `ticks` from now on task `handle` (the handle the app
    /// holds from spawn.start); `ticks < 2^31`. The task goes Pending until the
    /// deadline, then `expire` re-readies it. Returns 0 on success, or
    /// 0xFFFF_FFFF if `handle` is invalid / not Pending or `ticks` is out of range.
    sleep: func(handle: u32, ticks: u32) -> u32;
    /// Poll a timer handle: 0 = pending, 1 = elapsed, 0xFFFF_FFFF = invalid.
    slept: func(handle: u32) -> u32;
}

/// Bounded message channel — payloads live in the shared linmem as `own<msg>`.
/// Backed by gale::msgq's proven ring.
interface channel {
    /// A message buffer owned by whoever may currently touch it (send transfers it).
    resource msg {
        len: func() -> u32;
    }
    /// Non-blocking send; false if the ring is full (msg returned to caller-owned).
    send: func(m: msg) -> bool;
    /// Non-blocking receive; none if the ring is empty.
    recv: func() -> option<msg>;
}

/// RTIO/io_uring-shape I/O — submit an SQE over an owned buffer, poll for the CQE.
/// The buffer is `own<buffer>` (reuses the dma-own ownership model); no host Future.
/// Backed by the composed iodevs (spi/dma).
interface io {
    /// A DMA-capable buffer in the shared segment; passing it by value moves
    /// ownership to the engine for the transfer window (dma-own handoff).
    resource buffer {
        len: func() -> u32;
    }
    /// Submission-queue entry: op (0=read,1=write), target channel, and the buffer.
    submit: func(op: u32, channel: u32, buf: buffer) -> u32;
    /// Poll the completion queue for a submitted op-id; returns the re-owned buffer
    /// on completion, none while pending.
    poll-completion: func(op-id: u32) -> option<buffer>;
}

/// The app-facing world — an app imports the OS capabilities and exports its entry.
/// A node satisfies every import via its composed providers; the app links to
/// nothing else, so it is portable across nodes.
world app {
    import time;
    import log;
    import spawn;
    import channel;
    import io;
    import timer;
    export run: func() -> u32;
}

/// Step-1 slice: the minimal all-scalar world that proves the gust:os compose
/// end-to-end (app imports only time; a time provider exports it over gust:hal/mmio).
world app-time {
    import time;
    export run: func() -> u32;
}
world time-provider {
    import gust:hal/mmio@0.1.0;
    export time;
}

/// Step-2 slice: time + log (the first BUFFER-carrying capability). `log.line`
/// takes list<u8> → the CM canonical ABI needs a real shared linmem, so this node
/// is bounded-SRAM (not 0), sized to fit the F100 8 KiB via synth --native-pointer-abi.
world app-tl {
    import time;
    import log;
    export run: func() -> u32;
}
world log-provider {
    import gust:hal/mmio@0.1.0;
    export log;
}

/// Step-3 slice: time + spawn (the first EXECUTOR-BACKED capability). The spawn
/// provider OWNS NOTHING: `start`/`poll` marshal onto the one executor instance
/// through `gust:sched/tasks`, so a handle it returns is the executor's own handle
/// and means the same thing to `timer.sleep` and `exec.state`. It holds no state and
/// never touches the trusted dispatch seam — that belongs to the executor's owner.
world app-ts { import time; import spawn; export run: func() -> u32; }
world spawn-provider { import gust:sched/tasks@0.1.0; export spawn; }

/// Step-4 slice: time + timer (tickless one-shot sleep over the verified executor's
/// deadline table). Also stateless: the deadline table is the executor's, reached via
/// `gust:sched/tasks`, and the clock is `time`'s — so this world has NO gust:hal
/// import. Two providers reading the same timer register through a shared constant
/// was one clock only by coincidence; importing `time` makes it one clock by
/// construction.
world app-timer { import time; import timer; export run: func() -> u32; }
world timer-provider { import gust:sched/tasks@0.1.0; import time; export timer; }

/// The executor node itself as a provider, and the node's SINGLE owner of scheduler
/// state. It imports only the trusted dispatch seam and exports two views of the one
/// task table: the app-facing `exec` (not in `world app` — apps reach the scheduler
/// through spawn/timer) and the internal `gust:sched/tasks` that its stateless
/// siblings bind to. Composition satisfies the latter in place, so it never leaks
/// out of the fused component (gale#224).
world exec-provider { import taskdisp; export exec; export gust:sched/tasks@0.1.0; }
