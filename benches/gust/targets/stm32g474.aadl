package STM32G474
public
  with Cortex_M; with Gust_Target_Props;

  memory Flag_Flash end Flag_Flash;
  memory implementation Flag_Flash.i
    properties Gust_Target_Props::Base => 16#08000000#; Gust_Target_Props::Length => 524288;
  end Flag_Flash.i;

  memory Ram end Ram;
  memory implementation Ram.i
    properties Gust_Target_Props::Base => 16#20000000#; Gust_Target_Props::Length => 98304;
  end Ram.i;

  -- MEASURED 2026-09-04 on the NUCLEO-G474RE: the verified region programmer runs,
  -- and an unprivileged MPU_CTRL write is refused with a BusFault.
  device Mpu
    properties
      -- The MPU register block is ARCHITECTURAL (ARMv7-M PPB), identical on every
      -- Cortex-M, so this Base is not board-specific. MPU_TYPE lives at Base+0.
      Gust_Target_Props::Base    => 16#E000ED90#;
      Gust_Target_Props::Present => true;
      Gust_Target_Props::Dregion => 8;
  end Mpu;

  device Iwdg
    properties Gust_Target_Props::Base => 16#40003000#; Gust_Target_Props::Present => true;
  end Iwdg;

  device Rcc
    properties
      Gust_Target_Props::Base         => 16#40021000#;
      Gust_Target_Props::Csr_Offset   => 16#94#;
      Gust_Target_Props::Iwdgrstf_Bit => 29;
      Gust_Target_Props::Rmvf_Bit     => 23;
  end Rcc;

  -- DELIBERATELY EMPTY of peripherals beyond Iwdg/Rcc. NONE of the F100 peripheral
  -- bases in stm32f100.aadl may be copied here: the F1 and G4 memory maps differ,
  -- and this model already records a case in point — the SAME register (RCC_CSR)
  -- sits at a different offset on each family (16#24# vs 16#94#). Iwdg and the Rcc
  -- base happen to coincide across the two families, and EACH is separately
  -- silicon-validated on a real G474RE (targets/RESULTS-target-model.md) — that is
  -- why they, and only they, are modelled. Every gust driver gate runs on
  -- Cortex-M3/STM32F1-class platforms, so the tree holds NO G4 evidence for
  -- USART/GPIO/TIM/SPI/ADC bases, nor for an APB2ENR offset. Adding any of them
  -- needs an RM0440 datasheet source plus a G474 gate or silicon run; a guessed
  -- base would silently write to the wrong peripheral.

  system Board
    annex EMV2 {**
      error types
        TaskHang    : type;
        SystemReset : type;
      end types;
      error behavior WatchdogBehavior
        events   Hang : error event;
        states   Nominal : initial state; Reset : state;
        transitions Nominal -[ Hang ]-> Reset;   -- unrefreshed hang -> IWDG resets to safe state
      end behavior;
    **};
  end Board;
  system implementation Board.nucleo
    subcomponents
      cpu   : processor Cortex_M::CortexM4;
      flash : memory Flag_Flash.i;
      sram  : memory Ram.i;
      mpu   : device Mpu;
      iwdg  : device Iwdg;
      rcc   : device Rcc;
  end Board.nucleo;
end STM32G474;
